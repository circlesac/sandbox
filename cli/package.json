{
	"name": "@circlesac/sandbox",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/circlesac/sandbox.git",
		"directory": "cli"
	},
	"bin": {
		"sandbox": "bin/sandbox"
	},
	"files": [
		"bin"
	],
	"scripts": {
		"dev": "bun run src/index.ts",
		"postinstall": "node bin/install.js",
		"test": "bun run format:check && bun run lint && bun run typecheck && vitest run",
		"test:watch": "vitest",
		"test:sdk-matrix": "bun run scripts/sdk-matrix.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.4.1",
		"chanfana": "^3.0.0",
		"dockerode": "^4.0.9",
		"hono": "^4.11.9",
		"nanoid": "^5.1.6",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "latest",
		"@types/dockerode": "^4.0.1",
		"e2b": "^2.31.0",
		"typescript": "^5",
		"vitest": "^4.0.18"
	}
}
